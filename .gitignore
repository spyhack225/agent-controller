node_modules/
.data/
# The Parakeet sidecar's own interpreter (scripts/parakeet-sidecar.py). Created by
# `uv venv .venv-parakeet`; the ~630 MB of model weights live under .data/models/.
.venv-parakeet/
.manufacturing/
firmware/esp32-controller/.pio/
firmware/*/.pio/
# A board's checked-in example is the only controller_config variant allowed in source control.
# Ignore local, backup, editor, and future live-config suffixes by default.
firmware/*/include/controller_config*
!firmware/*/include/controller_config.example.h
.wrangler/
cloudflare/.wrangler/
cloudflare-control-plane/.wrangler/
.env
.DS_Store
coverage/
dist/
*.log

.env.local

# Elecrow's CrowPanel vendor download: 246 MB of .zip archives, a PDF manual, and CH34x macOS
# driver installers. Reference material, not source — the parts we actually build against are
# vendored into firmware/esp32-controller/lib/ElecrowEPD/ and committed.
# Re-downloadable from:
#   https://www.elecrow.com/wiki/CrowPanel_ESP32_E-Paper_HMI_2.13-inch_Display.html
firmware/esp32-controller/docs/
